import { NextRequest, NextResponse } from 'next/server';
import crypto from 'crypto';
import fs from 'fs';
import path from 'path';
import { kv } from '@vercel/kv';

const APPOINTMENTS_KEY = 'calendar_appointments';
const BLOCKED_KEY = 'calendar_blocked_times';
const DATA_DIR = path.join(process.cwd(), 'data');
const APPOINTMENTS_FILE = path.join(DATA_DIR, 'calendar_appointments.json');
const BLOCKED_FILE = path.join(DATA_DIR, 'calendar_blocked.json');

// Check if Redis is available
const hasRedisConfig = !!process.env.KV_REST_API_URL;

// Redis functions
async function getAppointmentsFromRedis(): Promise<any[]> {
  try {
    const appointments = await kv.get<any[]>(APPOINTMENTS_KEY);
    return appointments || [];
  } catch (e) {
    console.error('Error reading appointments from Redis:', e);
    return [];
  }
}

async function saveAppointmentsToRedis(appointments: any[]): Promise<void> {
  await kv.set(APPOINTMENTS_KEY, appointments);
}

async function getBlockedFromRedis(): Promise<any[]> {
  try {
    const blocked = await kv.get<any[]>(BLOCKED_KEY);
    return blocked || [];
  } catch (e) {
    console.error('Error reading blocked from Redis:', e);
    return [];
  }
}

// File fallback functions
function readAppointmentsFromFile(): any[] {
  try {
    if (fs.existsSync(APPOINTMENTS_FILE)) {
      return JSON.parse(fs.readFileSync(APPOINTMENTS_FILE, 'utf-8'));
    }
  } catch (e) {
    console.error('Error reading appointments from file:', e);
  }
  return [];
}

function saveAppointmentsToFile(appointments: any[]): void {
  try {
    if (!fs.existsSync(DATA_DIR)) {
      fs.mkdirSync(DATA_DIR, { recursive: true });
    }
    fs.writeFileSync(APPOINTMENTS_FILE, JSON.stringify(appointments, null, 2));
  } catch (e) {
    console.error('Error saving appointments to file:', e);
  }
}

function readBlockedFromFile(): any[] {
  try {
    if (fs.existsSync(BLOCKED_FILE)) {
      return JSON.parse(fs.readFileSync(BLOCKED_FILE, 'utf-8'));
    }
  } catch (e) {
    console.error('Error reading blocked from file:', e);
  }
  return [];
}

// Unified get/save with fallback
async function getAppointments(): Promise<any[]> {
  if (hasRedisConfig) {
    const appointments = await getAppointmentsFromRedis();
    if (appointments.length > 0) {
      return appointments;
    }
  }
  return readAppointmentsFromFile();
}

async function saveAppointments(appointments: any[]): Promise<void> {
  if (hasRedisConfig) {
    try {
      await saveAppointmentsToRedis(appointments);
    } catch (e) {
      console.error('Failed to save to Redis, falling back to file:', e);
      saveAppointmentsToFile(appointments);
    }
  } else {
    saveAppointmentsToFile(appointments);
  }
}

async function getBlocked(): Promise<any[]> {
  if (hasRedisConfig) {
    const blocked = await getBlockedFromRedis();
    if (blocked.length > 0) {
      return blocked;
    }
  }
  return readBlockedFromFile();
}

async function checkSlotAvailable(date: string, startTime: string, endTime: string, excludeId?: string): Promise<{available: boolean, reason?: string}> {
  const appointments = await getAppointments();
  const blocked = await getBlocked();
  
  // Validate inputs
  if (!date || !startTime || !endTime) {
    return { available: false, reason: 'Invalid input' };
  }
  
  // Check appointments
  const conflictingAppointment = appointments.find((apt: any) => {
    if (apt.status === 'cancelled') return false;
    if (excludeId && apt.id === excludeId) return false;
    if (apt.date !== date) return false;
    
    const existingStart = apt.startTime;
    const existingEnd = apt.endTime;
    return !(endTime <= existingStart || startTime >= existingEnd);
  });
  
  if (conflictingAppointment) {
    return { available: false, reason: 'Another client already has this time' };
  }
  
  // Check blocked times
  const requestedDate = new Date(date + "T00:00:00");
  const dayOfWeek = requestedDate.getDay();
  
  const isBlocked = blocked.some((blk: any) => {
    if (blk.date === date) {
      return !(endTime <= blk.startTime || startTime >= blk.endTime);
    }
    if (blk.isRecurring && blk.daysOfWeek && blk.daysOfWeek.includes(dayOfWeek)) {
      if (blk.endDate && date > blk.endDate) return false;
      return !(endTime <= blk.startTime || startTime >= blk.endTime);
    }
    return false;
  });
  
  if (isBlocked) {
    return { available: false, reason: 'This time is blocked' };
  }
  
  return { available: true };
}

// GET - List appointments
export async function GET(request: NextRequest) {
  const { searchParams } = new URL(request.url);
  const clientId = searchParams.get('clientId');
  const date = searchParams.get('date');
  
  let appointments = await getAppointments();
  
  if (clientId) {
    appointments = appointments.filter((a: any) => a.clientId === clientId);
  }
  
  if (date) {
    appointments = appointments.filter((a: any) => a.date === date);
  }
  
  return NextResponse.json(appointments);
}

// POST - Create or update appointment
export async function POST(request: NextRequest) {
  const body = await request.json();
  const { action, id, clientId, date, startTime, endTime, status, recurringId, recurringPattern } = body;

  // Validate common required fields
  if (action === 'create' || action === 'reschedule') {
    if (!clientId || !date || !startTime || !endTime) {
      return NextResponse.json({ error: 'Client ID, date, start time, and end time are required' }, { status: 400 });
    }
    if (startTime >= endTime) {
      return NextResponse.json({ error: 'End time must be after start time' }, { status: 400 });
    }
  }

  const appointments = await getAppointments();

  if (action === 'create') {
    const slotCheck = await checkSlotAvailable(date, startTime, endTime);
    if (!slotCheck.available) {
      return NextResponse.json({ error: slotCheck.reason || 'Time slot not available' }, { status: 400 });
    }
    
    const newAppointment = {
      id: crypto.randomUUID(),
      clientId,
      date,
      startTime,
      endTime,
      status: 'booked',
      recurringId: recurringId || null,
      recurringPattern: recurringPattern || null,
      createdAt: new Date().toISOString()
    };
    
    appointments.push(newAppointment);
    await saveAppointments(appointments);
    
    return NextResponse.json(newAppointment);
  }

  if (action === 'reschedule') {
    const index = appointments.findIndex((a: any) => a.id === id);
    if (index === -1) {
      return NextResponse.json({ error: 'Appointment not found' }, { status: 404 });
    }
    
    const slotCheck = await checkSlotAvailable(date, startTime, endTime, id);
    if (!slotCheck.available) {
      return NextResponse.json({ error: slotCheck.reason || 'Time slot not available' }, { status: 400 });
    }
    
    appointments[index] = {
      ...appointments[index],
      date,
      startTime,
      endTime
    };
    
    await saveAppointments(appointments);
    return NextResponse.json(appointments[index]);
  }

  if (action === 'cancel') {
    const index = appointments.findIndex((a: any) => a.id === id);
    if (index === -1) {
      return NextResponse.json({ error: 'Appointment not found' }, { status: 404 });
    }
    
    appointments[index].status = 'cancelled';
    await saveAppointments(appointments);
    return NextResponse.json(appointments[index]);
  }

  if (action === 'delete') {
    const index = appointments.findIndex((a: any) => a.id === id);
    if (index === -1) {
      return NextResponse.json({ error: 'Appointment not found' }, { status: 404 });
    }
    
    appointments.splice(index, 1);
    await saveAppointments(appointments);
    return NextResponse.json({ success: true });
  }

  if (action === 'schedule-recurring') {
    const { clientId: recClientId, startDate: recStartDate, startTime: recStartTime, endTime: recEndTime, daysOfWeek, endDate } = body;
    
    if (!recClientId || !recStartDate || !recStartTime || !recEndTime || !daysOfWeek || daysOfWeek.length === 0) {
      return NextResponse.json({ error: 'Missing required fields: clientId, startDate, startTime, endTime, and daysOfWeek are required' }, { status: 400 });
    }
    
    if (recStartTime >= recEndTime) {
      return NextResponse.json({ error: 'End time must be after start time' }, { status: 400 });
    }
    
    // Warn if scheduling too far in advance
    const maxRecurringDate = endDate ? new Date(endDate) : new Date(recStartDate);
    if (!endDate) {
      maxRecurringDate.setFullYear(maxRecurringDate.getFullYear() + 1);
    }
    const daysUntilEnd = Math.ceil((maxRecurringDate.getTime() - new Date(recStartDate).getTime()) / (1000 * 60 * 60 * 24));
    if (daysUntilEnd > 365) {
      return NextResponse.json({ error: 'Cannot schedule recurring appointments more than 1 year in advance' }, { status: 400 });
    }
    
    const recurringId = crypto.randomUUID();
    const createdAppointments = [];
    const blockedDates: string[] = [];
    const maxDate = endDate ? new Date(endDate + 'T23:59:59') : new Date(recStartDate + 'T23:59:59');
    if (!endDate) {
      maxDate.setFullYear(maxDate.getFullYear() + 1);
    }
    
    const currentDate = new Date(recStartDate + 'T00:00:00');
    
    while (currentDate <= maxDate) {
      const dayOfWeek = currentDate.getDay();
      
      if (daysOfWeek.includes(dayOfWeek)) {
        const dateStr = currentDate.toISOString().split('T')[0];
        
        const slotCheck = await checkSlotAvailable(dateStr, recStartTime, recEndTime);
        if (slotCheck.available) {
          const newAppointment = {
            id: crypto.randomUUID(),
            clientId: recClientId,
            date: dateStr,
            startTime: recStartTime,
            endTime: recEndTime,
            status: 'booked',
            recurringId,
            recurringPattern: daysOfWeek.join(','),
            createdAt: new Date().toISOString()
          };
          
          appointments.push(newAppointment);
          createdAppointments.push(newAppointment);
        } else if (slotCheck.reason?.includes('blocked')) {
          // Track blocked dates to report to user
          if (!blockedDates.includes(dateStr)) {
            blockedDates.push(dateStr);
          }
        }
      }
      
      currentDate.setDate(currentDate.getDate() + 1);
    }
    
    await saveAppointments(appointments);
    const response: any = { 
      message: `Created ${createdAppointments.length} appointments`,
      recurringId,
      appointments: createdAppointments
    };
    if (blockedDates.length > 0) {
      response.message += ` (${blockedDates.length} dates skipped due to blocked time: ${blockedDates.join(', ')})`;
      response.blockedDates = blockedDates;
      response.error = `Some dates were skipped because the time is blocked: ${blockedDates.join(', ')}`;
    }
    return NextResponse.json(response);
  }

  if (action === 'complete') {
    const index = appointments.findIndex((a: any) => a.id === id);
    if (index === -1) {
      return NextResponse.json({ error: 'Appointment not found' }, { status: 404 });
    }
    
    appointments[index].status = 'completed';
    await saveAppointments(appointments);
    return NextResponse.json(appointments[index]);
  }

  return NextResponse.json({ error: 'Invalid action' }, { status: 400 });
}

// DELETE - Delete appointment
export async function DELETE(request: NextRequest) {
  const { searchParams } = new URL(request.url);
  const id = searchParams.get('id');
  
  if (!id) {
    return NextResponse.json({ error: 'Appointment ID required' }, { status: 400 });
  }
  
  const appointments = await getAppointments();
  const index = appointments.findIndex((a: any) => a.id === id);
  
  if (index === -1) {
    return NextResponse.json({ error: 'Appointment not found' }, { status: 404 });
  }
  
  appointments.splice(index, 1);
  await saveAppointments(appointments);
  
  return NextResponse.json({ success: true });
}